{
  "name": "d1-r2-kv-backup-migration-center",
  "version": "1.0.0",
  "description": "Cloudflare D1 + R2 + KV 数据备份、恢复与跨账号迁移中心",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "hltxme",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "r2",
    "kv",
    "backup",
    "migration"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "check": "node --check src/index.js",
    "db:init": "wrangler d1 execute d1-r2-kv-center --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute d1-r2-kv-center --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute d1-r2-kv-center --remote --file=./seed.sql",
    "db:console": "wrangler d1 execute d1-r2-kv-center --remote --command=\"SELECT * FROM users\""
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=18"
  }
}
