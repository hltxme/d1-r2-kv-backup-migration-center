{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "d1-r2-kv-backup-migration-center",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },

  // ── 静态资源：public/ 目录下的前端页面 ────────────────────────────────
  // 除 /api/* 与少量自定义路由外，全部由静态资源直接返回（免费、走 CDN）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/login", "/app", "/health"]
  },

  // ── D1 绑定：应用自身的元数据库（用户 / CF账号 / 资源清单 / 任务）──────
  // 这里不写 database_id，Wrangler 会**自动创建**同名 D1 并回填 ID：
  //   · 命令行：npm run deploy 时自动创建
  //   · 浏览器：Cloudflare 控制台 / Deploy 按钮部署时同样自动创建
  // 若你已有数据库，也可以手动填入 database_id
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "d1-r2-kv-center"
    }
  ],

  // ── 可公开的运行参数（不含任何密钥）──────────────────────────────────
  "vars": {
    "APP_NAME": "D1 + R2 + KV 数据备份与跨账号迁移中心",
    "APP_SHORT_NAME": "Backup Center",
    "APP_VERSION": "1.0.0",
    "APP_DEFAULT_LOCALE": "zh-CN",
    "APP_DEFAULT_THEME": "light",
    "APP_DEFAULT_ACCENT": "indigo",
    "SESSION_TTL_DAYS": "7",
    "CAPTCHA_TTL_SECONDS": "300",
    "LOGIN_MAX_ATTEMPTS": "5",
    "LOGIN_LOCK_MINUTES": "10",

    // ⚠️ PBKDF2 迭代次数直接决定每次哈希的 CPU 耗时，请勿随意调高：
    //   120000 次 ≈ 19ms CPU，会超过 Workers 免费版「每请求 10ms」的 CPU 上限，
    //   导致 bootstrap 创建默认管理员 / 修改密码 静默失败（Error 1102）。
    //   10000 次 ≈ 1.6ms，留有安全余量。
    //   若已升级 Workers Paid（CPU 上限 30s），可调回 120000 增强强度。
    "PBKDF2_ITERATIONS": "10000"
  }

  // ── 密钥请用 wrangler secret 设置，不要写进本文件 ────────────────────
  //   npx wrangler secret put APP_SECRET        # 用于加密存储 CF API Token
  //   npx wrangler secret put ADMIN_PASSWORD    # 可选：覆盖默认初始密码
}
